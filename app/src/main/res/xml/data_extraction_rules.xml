<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device: the stored Moodle token is tied to this phone
     and must not be restored on another one. Android 12+; allowBackup="false"
     in the manifest covers older versions. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
